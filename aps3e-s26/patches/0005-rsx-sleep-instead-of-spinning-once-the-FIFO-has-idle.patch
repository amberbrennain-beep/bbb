--- a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.h
+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.h
@@ -188,6 +188,7 @@ namespace rsx
 		void recover_fifo(std::source_location src_loc = std::source_location::current());
 
 		static void fifo_wake_delay(u64 div = 1);
+		void fifo_idle_wait();
 		u32 get_fifo_cmd() const;
 
 		void dump_regs(std::string&, std::any& custom_data) const override;
diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/system_config.h b/app/src/main/cpp/rpcs3/rpcs3/Emu/system_config.h
index 737518dfc..f5c439579 100644
--- a/app/src/main/cpp/rpcs3/rpcs3/Emu/system_config.h
+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/system_config.h
@@ -181,6 +181,8 @@ struct cfg_root : cfg::node
 		cfg::_int<0, 16> shader_compiler_threads_count{ this, "Shader Compiler Threads", 0 };
 		cfg::_int<0, 30000000> driver_recovery_timeout{ this, "Driver Recovery Timeout", 1000000, true };
 		cfg::uint<0, 16667> driver_wakeup_delay{ this, "Driver Wake-Up Delay", 0, true };
+		// Once the FIFO has been idle this long (us), RSX sleeps in slices of it instead of spinning (0 = always spin)
+		cfg::uint<0, 5000> rsx_idle_sleep{ this, "RSX Idle Sleep", 100, true };
 		cfg::_int<1, 6000> vblank_rate{ this, "Vblank Rate", 60, true }; // Changing this from 60 may affect game speed in unexpected ways
 		cfg::_bool vblank_ntsc{ this, "Vblank NTSC Fixup", false, true };
 		cfg::_bool decr_memory_layout{ this, "DECR memory layout", false}; // Force enable increased allowed main memory range as DECR console
