+  RSX Idle Sleep: 100
   Vblank Rate: 60
   Vblank NTSC Fixup: false
   DECR memory layout: false
diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXFIFO.cpp b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXFIFO.cpp
index 8dfc43539..ceafd3663 100644
--- a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXFIFO.cpp
+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXFIFO.cpp
@@ -669,7 +669,7 @@ namespace rsx
 				}
 				else
 				{
-					std::this_thread::yield();
+					fifo_idle_wait();
 				}
 
 				return;
@@ -702,6 +702,10 @@ namespace rsx
 						performance_counters.FIFO_idle_timestamp = get_system_time();
 						sync_point_request.release(true);
 					}
+					else
+					{
+						fifo_idle_wait();
+					}
 
 					performance_counters.state = FIFO::state::spinning;
 				}
diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.cpp b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.cpp
index cfa735fe8..38a53bf7f 100644
--- a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.cpp
+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.cpp
@@ -3030,6 +3030,25 @@ namespace rsx
 		return result;
 	}
 
+	void thread::fifo_idle_wait()
+	{
+		// A game waiting on the PPU leaves the FIFO empty or parked on a jump-to-self. Yielding there returns at once
+		// on Android when nothing else is runnable on the core, so the RSX thread kept a prime core at 100% and
+		// turned that into heat the PPU/SPU threads then lose to throttling. Past the idle threshold, sleep instead.
+		const u64 slice = g_cfg.video.rsx_idle_sleep;
+
+		if (!slice || get_system_time() - performance_counters.FIFO_idle_timestamp < slice)
+		{
+			std::this_thread::yield();
+			return;
+		}
+
+		thread_ctrl::wait_for(slice, false);
+
+		// Service deferred flips, interrupts and flush requests on the next iteration instead of every 64th
+		m_eng_interrupt_mask |= rsx::backend_interrupt;
+	}
+
 	void thread::fifo_wake_delay(u64 div)
 	{
 		// TODO: Nanoseconds accuracy
diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.h b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/RSXThread.h
