From e8288a780c7ad825c1008a802d1f03c3420529a3 Mon Sep 17 00:00:00 2001
From: aps3e-s26 <aps3e-s26@users.noreply.github.com>
Date: Mon, 26 Oct 2026 13:53:23 +0000
Subject: [PATCH 08/10] android: request 60 Hz on the emulator surface

PS3 games present at most 60 fps, but the S26's LTPO panel otherwise keeps
refreshing at up to 120 Hz for the game window. Hint 60 Hz fixed-source
content on the surface (seamless switches only, so no mode-change flash);
the display runs at half the rate while a game is on screen, saving power
the SoC can spend on clocks instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QHcVVDuR9mxorL6GkyZmzr
---
 app/src/main/java/aenu/aps3e/EmulatorActivity.java | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/app/src/main/java/aenu/aps3e/EmulatorActivity.java b/app/src/main/java/aenu/aps3e/EmulatorActivity.java
index 554f7fb36..d504f7828 100644
--- a/app/src/main/java/aenu/aps3e/EmulatorActivity.java
+++ b/app/src/main/java/aenu/aps3e/EmulatorActivity.java
@@ -637,6 +637,13 @@ public class EmulatorActivity extends AppCompatActivity {
 
 		@Override
 		public void surfaceCreated(SurfaceHolder holder) {
+			// PS3 output is at most 60 fps. Let a 120 Hz LTPO panel (Galaxy S26) drop to 60 Hz while a game runs,
+			// when it can switch seamlessly, instead of refreshing twice per game frame for nothing but power and heat.
+			if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+				holder.getSurface().setFrameRate(60f, Surface.FRAME_RATE_COMPATIBILITY_FIXED_SOURCE,
+						Surface.CHANGE_FRAME_RATE_ONLY_IF_SEAMLESS);
+			}
+
 			if (!started) {
 				started = true;
 				try {
