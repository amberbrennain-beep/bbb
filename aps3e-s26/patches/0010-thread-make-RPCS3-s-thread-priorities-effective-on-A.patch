From 7872ce5ea89fa89f385a06ed72090cb9a38004bf Mon Sep 17 00:00:00 2001
From: aps3e-s26 <aps3e-s26@users.noreply.github.com>
Date: Mon, 26 Oct 2026 13:04:54 +0000
Subject: [PATCH 10/12] thread: make RPCS3's thread priorities effective on
 Android

RPCS3 raises RSX, cellAudio and rsxaudio threads (+1) and lowers its PPU
and SPU precompile workers and the log writer (-1), but on Linux this goes
through pthread_setschedparam with SCHED_OTHER, whose only priority is 0:
a no-op. Android apps may renice their own threads, so map +1/-1 to nice
-4/+4. Frame-critical and audio threads then win contention with other
runnable threads, and background compilation no longer takes equal CPU
share from the game threads.
---
 app/src/main/cpp/rpcs3/Utilities/Thread.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/app/src/main/cpp/rpcs3/Utilities/Thread.cpp b/app/src/main/cpp/rpcs3/Utilities/Thread.cpp
index db17e4527..f7db0438c 100644
--- a/app/src/main/cpp/rpcs3/Utilities/Thread.cpp
+++ b/app/src/main/cpp/rpcs3/Utilities/Thread.cpp
@@ -3862,6 +3862,22 @@ void thread_ctrl::set_native_priority(int priority)
 	{
 		sig_log.error("SetThreadPriority() failed: %s", fmt::win_error{GetLastError(), nullptr});
 	}
+#elif defined(__ANDROID__)
+	// SCHED_OTHER has a single static priority, so the pthread path below does nothing on Linux. Android lets an
+	// app renice its own threads (the framework runs its UI and render threads at -4 itself): use that, so RSX and
+	// the audio threads get ahead of other runnable threads and background compile workers stop competing with
+	// the game threads at equal weight.
+	const int nice_value = priority > 0 ? -4 : priority < 0 ? 4 : 0;
+
+	if (setpriority(PRIO_PROCESS, static_cast<id_t>(syscall(SYS_gettid)), nice_value) != 0)
+	{
+		static atomic_t<bool> s_reported = false;
+
+		if (!s_reported.exchange(true))
+		{
+			sig_log.warning("setpriority(%d) failed: %d (further failures are not reported)", nice_value, errno);
+		}
+	}
 #else
 	int policy;
 	struct sched_param param;
