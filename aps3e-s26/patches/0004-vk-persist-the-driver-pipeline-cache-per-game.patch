 .../rpcs3/Emu/RSX/VK/VKPipelineCompiler.cpp   | 147 +++++++++++++++++-
 .../rpcs3/Emu/RSX/VK/VKPipelineCompiler.h     |   3 +
 .../rpcs3/rpcs3/Emu/RSX/VK/vkutils/device.h   |   1 +
 5 files changed, 155 insertions(+), 3 deletions(-)

diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKGSRender.cpp b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKGSRender.cpp
index e0cc015c4..fa2ed04f4 100644
--- a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKGSRender.cpp
+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKGSRender.cpp
@@ -1286,6 +1286,10 @@ void VKGSRender::on_init_thread()
 	{
 		vk::resize_pipe_compiler(g_cfg.video.shader_compiler_threads_count);
 	}
+
+	// Persist what the startup shader cache load just compiled. Android often kills the process instead of letting
+	// the renderer tear down, and the teardown flush alone would then never happen.
+	vk::flush_pipeline_cache();
 }
 
 void VKGSRender::on_exit()
diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKPFNTable.h b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKPFNTable.h
