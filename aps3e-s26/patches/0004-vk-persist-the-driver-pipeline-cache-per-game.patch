+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/RSX/VK/VKPFNTable.h
@@ -127,6 +127,9 @@ VK_FUNC(vkDestroyPipelineLayout);
 VK_FUNC(vkCreateGraphicsPipelines);
 VK_FUNC(vkCreateComputePipelines);
 VK_FUNC(vkDestroyPipeline);
