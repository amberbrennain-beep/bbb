diff --git a/src/video_core/macro.cpp b/src/video_core/macro.cpp
index 86f528af1..ea98be6d3 100644
--- a/src/video_core/macro.cpp
+++ b/src/video_core/macro.cpp
@@ -421,9 +421,9 @@ void HLE_TransformFeedbackSetup::Execute(Core::System& system, Engines::Maxwell3
 void MacroInterpreterImpl::Execute(Core::System& system, Engines::Maxwell3D& maxwell3d, std::span<const u32> params, u32 method) {
     Reset();
 
+    code = std::span(*storage).subspan(code_start, code_size);
+    parameters = params;
     registers[1] = params[0];
-    parameters.resize(params.size());
-    std::memcpy(parameters.data(), params.data(), params.size() * sizeof(u32));
 
     // Execute the code until we hit an exit condition.
     bool keep_executing = true;
@@ -441,7 +441,6 @@ void MacroInterpreterImpl::Reset() {
     pc = 0;
     delayed_pc = {};
