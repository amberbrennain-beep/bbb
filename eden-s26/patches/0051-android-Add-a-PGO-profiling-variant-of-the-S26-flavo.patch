+    // Profile counters written by profiling (PGO) builds, see native.cpp
+    private fun profileFiles(): List<File> {
+        val userDirectory = DirectoryInitialization.userDirectory ?: return emptyList()
+        return File(userDirectory, "pgo").listFiles { file -> file.name.endsWith(".profraw") }
+            ?.toList() ?: emptyList()
+    }
+
+    private fun shareProfile() {
+        val uris = ArrayList(
+            profileFiles().map {
+                DocumentsContract.buildDocumentUri(
+                    DocumentProvider.AUTHORITY,
+                    "${DocumentProvider.ROOT_ID}/pgo/${it.name}"
+                )
+            }
+        )
+        if (uris.isEmpty()) {
+            Toast.makeText(
+                requireContext(),
+                getText(R.string.share_profile_missing),
+                Toast.LENGTH_SHORT
+            ).show()
+            return
+        }
+        val intent = Intent(Intent.ACTION_SEND_MULTIPLE)
+            .setType("application/octet-stream")
+            .putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris)
+            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        startActivity(Intent.createChooser(intent, getText(R.string.share_profile)))
+    }
