From 85e581a3e86e799f92079bad366944b94bef38e2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 23:43:06 +0000
Subject: [PATCH 51/51] [android] Add a PGO profiling variant of the S26 flavor

-PpgoGenerate=true instruments the build (YUZU_PGO_GENERATE); counters are
written to <user>/pgo/eden-<pid>.profraw every two minutes and when a game
stops, and Settings gains a Share profile data entry while such files
exist. YUZU_PGO_USE takes the merged profile for the optimised build.
---
 CMakeLists.txt                                | 15 +++++++
 src/android/app/build.gradle.kts              | 13 ++++--
 .../fragments/HomeSettingsFragment.kt         | 43 +++++++++++++++++++
 src/android/app/src/main/jni/native.cpp       | 42 ++++++++++++++++++
 .../app/src/main/res/values/strings.xml       |  3 ++
 5 files changed, 113 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 320e701ba..436fb8f44 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -371,6 +371,21 @@ if (CXX_GCC OR CXX_CLANG)
     endif()
 endif()
 
+# Profile-guided optimisation
+option(YUZU_PGO_GENERATE "Instrument the build to collect a PGO profile" OFF)
+set(YUZU_PGO_USE "" CACHE FILEPATH "Merged .profdata file to optimise the build with")
+if (YUZU_PGO_GENERATE AND CXX_CLANG)
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:-fprofile-generate>)
+    add_link_options(-fprofile-generate)
+    add_compile_definitions(YUZU_PGO_GENERATE)
+elseif (NOT YUZU_PGO_USE STREQUAL "" AND CXX_CLANG)
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:-fprofile-use=${YUZU_PGO_USE}>
+                        $<$<COMPILE_LANGUAGE:C,CXX>:-Wno-profile-instr-out-of-date>
+                        $<$<COMPILE_LANGUAGE:C,CXX>:-Wno-profile-instr-unprofiled>
+                        $<$<COMPILE_LANGUAGE:C,CXX>:-Wno-profile-instr-missing>
+                        $<$<COMPILE_LANGUAGE:C,CXX>:-Wno-backend-plugin>)
+endif()
+
 # Configure C++ standard
 # ===========================
 
