diff --git a/src/android/app/src/main/jni/native.cpp b/src/android/app/src/main/jni/native.cpp
index d4f768993..f0c450253 100644
--- a/src/android/app/src/main/jni/native.cpp
+++ b/src/android/app/src/main/jni/native.cpp
@@ -20,6 +20,13 @@
 #include <thread>
 #include <vector>
 #include <dlfcn.h>
+#ifdef YUZU_PGO_GENERATE
+#include <chrono>
+#include <mutex>
+#include <sys/stat.h>
+extern "C" int __llvm_profile_write_file(void);
+extern "C" void __llvm_profile_set_filename(const char*);
+#endif
 #include <unistd.h>
 
 #include <iostream>
@@ -355,6 +362,35 @@ Core::SystemResultStatus EmulationSession::InitializeEmulation(const std::string
     return Core::SystemResultStatus::Success;
 }
 
+#ifdef YUZU_PGO_GENERATE
+namespace {
+std::mutex g_pgo_mutex;
+
+// Counters are cumulative per process; each process writes its own file, so rewrites never
+// double count.
+void WritePgoProfile() {
+    std::scoped_lock lock{g_pgo_mutex};
+    __llvm_profile_write_file();
+}
+
+void StartPgoProfile(const std::string& app_directory) {
+    static std::once_flag started;
+    std::call_once(started, [&] {
+        const std::string dir = app_directory + "/pgo";
+        mkdir(dir.c_str(), 0770);
+        static const std::string pattern = dir + "/eden-%p.profraw";
+        __llvm_profile_set_filename(pattern.c_str());
+        std::thread([] {
+            while (true) {
+                std::this_thread::sleep_for(std::chrono::minutes{2});
+                WritePgoProfile();
+            }
+        }).detach();
+    });
+}
+} // namespace
+#endif
+
 void EmulationSession::ShutdownEmulation() {
     std::scoped_lock lock(m_mutex);
 
