From 6ccb73e81efb8eac65abc9cf959ba72898577a4c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 17:17:41 +0000
Subject: [PATCH 50/50] [cmake] Drop -mtune=oryon-1 from the s26 preset

With Clang 21 it makes the backend emit SHA3 (eor3) instructions even when
the feature is disabled in -march.
---
 CMakeLists.txt | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f10c218ed..320e701ba 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -354,13 +354,9 @@ if (CXX_GCC OR CXX_CLANG)
         elseif (${YUZU_BUILD_PRESET} STREQUAL "s26")
             # Galaxy S26: common subset of Snapdragon 8 Elite Gen 5 (Oryon) and Exynos 2600 (C1).
             # No SVE, Oryon does not implement it.
+            # No -mtune=oryon-1 either: Clang 21 lets it enable SHA3 code generation even with
+            # +nosha3, which is not confirmed on the phone's Oryon cores.
             set(march armv8.6-a+fp16+aes+sha2)
-            # Schedule for Oryon; this does not change the instruction set.
-            include(CheckCXXCompilerFlag)
-            check_cxx_compiler_flag(-mtune=oryon-1 COMPILER_HAS_ORYON_TUNE)
-            if (COMPILER_HAS_ORYON_TUNE)
-                set(mtune oryon-1)
-            endif()
         endif()
     endif()
 
