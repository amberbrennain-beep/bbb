From: PavelBARABANOV <pavelbarabanov94@gmail.com>
Date: Wed, 21 Oct 2026 00:27:54 +0300
Subject: [PATCH 31/51] scanning from the update folder

(cherry picked from commit 0c6d17ac3af96b23320c067d0cccc52a48cda31d)
---
 src/core/file_sys/registered_cache.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/core/file_sys/registered_cache.cpp b/src/core/file_sys/registered_cache.cpp
index 287a46aef..ea8a3b1a5 100644
--- a/src/core/file_sys/registered_cache.cpp
+++ b/src/core/file_sys/registered_cache.cpp
@@ -1449,9 +1449,9 @@ void ExternalContentProvider::ScanDirectory(const VirtualDir& dir) {
 
         const auto extension = Common::ToLower(filename.substr(dot_pos + 1));
 
-        if (extension == "nsp") {
+        if (extension == "nsp" || extension == "nsz") {
             ProcessNSP(file);
-        } else if (extension == "xci") {
+        } else if (extension == "xci" || extension == "xcz") {
             ProcessXCI(file);
         }
     }
